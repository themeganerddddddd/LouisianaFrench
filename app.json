{
  "expo": {
    "name": "Louisiana Languages",
    "slug": "louisiana-french",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/images/pelicanicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.westleysturhan.louisianafrench",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.louisianalanguages.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pelicanicon.png",
        "backgroundColor": "#2771CB"
      }
    },
    "web": {
      "favicon": "./assets/images/pelicanicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "92b3549d-fbd2-432d-a052-4d39e311b4f1"
      },
      "bugReportEmail": "louisianafrenchsupport@gmail.com"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Louisiana Languages to record pronunciation practice.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "com.westleysturhan.louisianafrench"
  }
}
