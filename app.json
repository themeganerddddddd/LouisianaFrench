{
  "expo": {
    "name": "Louisiana French",
    "slug": "louisiana-french",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/pelicanicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.westleysturhan.louisianafrench",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.westleysturhan.louisianafrench",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pelicanicon.png",
        "backgroundColor": "#2771CB"
      }
    },
    "web": {
      "favicon": "./assets/images/pelicanicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "92b3549d-fbd2-432d-a052-4d39e311b4f1"
      },
      "bugReportEmail": "louisianafrenchsupport@gmail.com"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Louisiana French to record pronunciation practice."
        }
      ]
    ]
  }
}
