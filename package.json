{
  "name": "louisiana-french-v5",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prototype": "expo start",
    "test": "jest --watchAll=false",
    "check:google-oauth": "node scripts/check-google-oauth.mjs",
    "lint": "eslint .",
    "agent:worktree": "node .opencode/scripts/agent-worktree.mjs",
    "worktree:gc": "node .opencode/scripts/worktree-gc.mjs",
    "test:changed": "node .opencode/scripts/test-changed.mjs",
    "check:ui-evidence": "node .opencode/scripts/check-pr-ui-evidence.mjs",
    "capture:ui-evidence": "node .opencode/scripts/capture-ui-evidence.mjs",
    "pr-ready": "node .opencode/scripts/pr-ready.mjs",
    "ticket:context": "node .opencode/scripts/ticket-context.mjs",
    "validate:authority": "node .opencode/scripts/validate-authority.mjs",
    "validate:drift": "node .opencode/scripts/validate-drift.mjs",
    "validate:plan": "node .opencode/scripts/validate-plan.mjs",
    "validate:ledger": "node .opencode/scripts/validate-ledger.mjs",
    "validate:fixture-sep": "node .opencode/scripts/validate-fixture-sep.mjs",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build": "npm run build:ios && npm run build:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "@ronradtke/react-native-markdown-display": "^9.0.3",
    "@supabase/supabase-js": "^2.117.3",
    "aes-js": "^3.1.2",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "globals": "^17.7.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@ronradtke/react-native-markdown-display|react-native-fit-image))"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  }
}
